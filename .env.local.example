NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Service role / secret key do Supabase (Project Settings -> API). Server-only,
# usada pelo portal do cliente para consultar a O.S. sem precisar de login da equipe.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Qualquer string aleatória longa (ex: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`).
# Assina a sessão do portal do cliente — troque para invalidar todas as sessões ativas.
PORTAL_SESSION_SECRET=troque-por-uma-string-aleatoria-longa
